# Local changes to the upstream source in src/ (or mpc/), as unified diffs against the files as they
# were vendored. Each is described in README.md under "Changes for the MPC".
--- a/src/dsp/braids/macro_oscillator.h
+++ b/src/dsp/braids/macro_oscillator.h
@@ -65,6 +65,13 @@
   }
 
   inline void set_pitch(int16_t pitch) {
+#ifdef MPC_PORT
+    // MPC port (2026-10-02): the module's firmware keeps pitch in 0..16383 before it gets here; the plugin's note +
+    // 44.1 kHz correction + FM + bend reaches ~19800, and pitch-indexed tables (the flute's body filter, 128 entries
+    // for pitch >> 7) were read past their end (found with steve/tools/fuzz).
+    if (pitch < 0) pitch = 0;
+    if (pitch > 16383) pitch = 16383;
+#endif
     pitch_ = pitch;
   }
 
--- a/src/dsp/braids/digital_oscillator.cc
+++ b/src/dsp/braids/digital_oscillator.cc
@@ -87,6 +87,14 @@ uint32_t DigitalOscillator::ComputeDelay(int16_t midi_pitch) {
   uint32_t a = lut_oscillator_delays[ref_pitch >> 4];
   uint32_t b = lut_oscillator_delays[(ref_pitch >> 4) + 1];
   uint32_t delay = a + (static_cast<int32_t>(b - a) * (ref_pitch & 0xf) >> 4);  
+#ifdef MPC_PORT
+  // aarch64 build (2026-11-15): more than 12 octaves below the table (COMB, low notes with TIMBRE down) made the
+  // shift count negative, i.e. huge as a size_t: undefined in C++. A 32-bit ARM shifts everything out and gives 0;
+  // AArch64 takes the count modulo 32 and gives 0..15. Give 0 on both (found with UBSan, all-models sweep).
+  if (num_shifts > 12) {
+    return 0;
+  }
+#endif
   delay >>= 12 - num_shifts;
   return delay;
 }
